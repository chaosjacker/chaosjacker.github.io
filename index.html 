<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>我的 GitHub 主页</title>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    }
    body {
        background-color: #fcfaff;
        background-image: url("torinoaqua_394aa6b23d9042e18c0026784cad3fbf.jpg");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: #333;
        padding: 16px;
        max-width: 1024px;
        margin: 0 auto;
    }

    .profile-card {
        background: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 14px rgba(0, 0, 0, 0.08);
        margin-bottom: 20px;
    }
    .banner-img {
        width: 100%;
        height: 340px;
        object-fit: cover;
        display: block;
        background: linear-gradient(135deg, #e9d8fd, #d6bcfa);
    }
    .profile-info {
        padding: 20px 24px 24px;
    }
    .profile-info h2 {
        font-size: 22px;
        margin-bottom: 6px;
        color: #222;
    }
    .bio-text {
        color: #666;
        margin-bottom: 14px;
        line-height: 1.6;
    }
    .tag-group {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .tag {
        background-color: #efe6f9;
        color: #6b46c1;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 500;
    }

    .grid-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }
    .stat-card {
        background: #fff;
        padding: 20px 24px;
        border-radius: 18px;
        box-shadow: 0 2px 14px rgba(0, 0, 0, 0.08);
    }
    .stat-card h3 {
        font-size: 15px;
        color: #555;
        margin-bottom: 12px;
        font-weight: 600;
    }
    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #2d3748;
        line-height: 1.2;
    }
    .stat-sub {
        font-size: 13px;
        color: #999;
        margin-top: 6px;
    }
    .stat-line {
        font-size: 14px;
        color: #555;
        line-height: 1.9;
    }
    .stat-line b {
        color: #2d3748;
    }

    .lang-bar-container {
        width: 100%;
        height: 10px;
        background: #f0edf5;
        border-radius: 5px;
        margin: 10px 0 8px;
        overflow: hidden;
        display: flex;
    }
    .lang-seg {
        height: 100%;
    }
    .lang-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        font-size: 13px;
        color: #666;
    }
    .lang-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 5px;
        vertical-align: middle;
    }

    .repo-card {
        background: #fff;
        border-radius: 18px;
        padding: 20px 24px;
        box-shadow: 0 2px 14px rgba(0, 0, 0, 0.08);
    }
    .repo-card h3 {
        font-size: 16px;
        color: #333;
        margin-bottom: 8px;
    }
    .repo-card .update-time {
        float: right;
        font-size: 12px;
        color: #aaa;
        font-weight: 400;
    }
    .repo-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px 0;
        border-bottom: 1px solid #f3f0f8;
        text-decoration: none;
        color: inherit;
    }
    .repo-item:last-child {
        border-bottom: none;
    }
    .repo-name {
        font-size: 15px;
        font-weight: 600;
        color: #6b46c1;
    }
    .repo-desc {
        font-size: 13px;
        color: #888;
        margin-top: 3px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .repo-meta {
        text-align: right;
        font-size: 13px;
        color: #888;
        flex-shrink: 0;
    }
    .repo-lang {
        display: inline-block;
        font-size: 12px;
        color: #666;
        background: #f5f2fa;
        padding: 2px 8px;
        border-radius: 99px;
        margin-top: 4px;
    }

    .loading {
        color: #aaa;
        font-size: 14px;
    }

    footer {
        text-align: center;
        padding: 24px 0 8px;
        font-size: 13px;
        color: #aaa;
    }
    footer a {
        color: #8b7ab8;
        text-decoration: none;
    }
    footer a:hover {
        text-decoration: underline;
    }

    @media (max-width: 480px) {
        .banner-img { height: 180px; }
        .stat-value { font-size: 24px; }
    }
</style>
</head>
<body>

<div class="profile-card">
    <img class="banner-img" src="HNRXlRUaoAA6SmH.jpg" alt="banner">
    <div class="profile-info">
        <h2 id="user-name">加载中…</h2>
     